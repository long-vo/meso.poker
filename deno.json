{
  "name": "meso.poker",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "start": "deno run --unstable-kv --allow-net --allow-read --allow-write --allow-env main.ts",
    "dev": "PORT=8001 deno run --unstable-kv --allow-net --allow-read --allow-write --allow-env --watch main.ts",
    "test": "deno test --allow-read --allow-net --allow-write --allow-env --unstable-kv",
    "check": "deno check main.ts src/poker.test.ts src/poker-stats.test.ts src/poker-server.test.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "exclude": ["static/**/*.html"]
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
